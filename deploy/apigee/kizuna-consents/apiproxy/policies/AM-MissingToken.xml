<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- FaultRule: petición sin Authorization (Anexo A.2). -->
<AssignMessage name="AM-MissingToken">
    <DisplayName>AM-MissingToken</DisplayName>
    <Set>
        <Headers>
            <Header name="WWW-Authenticate">Bearer</Header>
        </Headers>
        <Payload contentType="application/json">{"detail":"Falta el token de acceso"}</Payload>
        <StatusCode>401</StatusCode>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
