<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- API Key de la API (secreto API_KEY), guardada en el KVM cifrado del entorno. Variable private.: no sale en Debug. -->
<KeyValueMapOperations name="KVM-GetBackendKey" mapIdentifier="consent-backend">
    <DisplayName>KVM-GetBackendKey</DisplayName>
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <Get assignTo="private.backend_api_key" index="1">
        <Key>
            <Parameter>api_key</Parameter>
        </Key>
    </Get>
</KeyValueMapOperations>
