<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    AssignMessage ejecuta sus acciones en el orden en que aparecen: primero quita el Bearer de KIZUNA y cualquier
    X-API-Key que haya enviado, después pone la API Key de la API. Sin la key (KVM vacío) la petición falla.
-->
<AssignMessage name="AM-BackendHeaders">
    <DisplayName>AM-BackendHeaders</DisplayName>
    <Remove>
        <Headers>
            <Header name="Authorization"/>
            <Header name="X-API-Key"/>
        </Headers>
    </Remove>
    <Set>
        <Headers>
            <Header name="X-API-Key">{private.backend_api_key}</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
