<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- FaultRule: token inválido, vencido o revocado, o sin la palabra Bearer (Anexo A.2). -->
<AssignMessage name="AM-InvalidToken">
    <DisplayName>AM-InvalidToken</DisplayName>
    <Set>
        <Headers>
            <Header name="WWW-Authenticate">Bearer error="invalid_token"</Header>
        </Headers>
        <Payload contentType="application/json">{"detail":"Token de acceso inválido o vencido"}</Payload>
        <StatusCode>401</StatusCode>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
