<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Respuesta del token en formato RFC 6749 §5.1, con las variables de OA-GenerateToken (expires_in en segundos). -->
<AssignMessage name="AM-TokenResponse">
    <DisplayName>AM-TokenResponse</DisplayName>
    <Set>
        <Headers>
            <Header name="Cache-Control">no-store</Header>
            <Header name="Pragma">no-cache</Header>
        </Headers>
        <Payload contentType="application/json">{"access_token":"{oauthv2accesstoken.OA-GenerateToken.access_token}","token_type":"Bearer","expires_in":{oauthv2accesstoken.OA-GenerateToken.expires_in},"scope":"{oauthv2accesstoken.OA-GenerateToken.scope}"}</Payload>
        <StatusCode>200</StatusCode>
    </Set>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
