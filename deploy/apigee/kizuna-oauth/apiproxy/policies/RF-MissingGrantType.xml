<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Falta grant_type, o el cuerpo no es application/x-www-form-urlencoded (Anexo A.1). -->
<RaiseFault name="RF-MissingGrantType">
    <DisplayName>RF-MissingGrantType</DisplayName>
    <FaultResponse>
        <Set>
            <Headers>
                <Header name="Cache-Control">no-store</Header>
            </Headers>
            <Payload contentType="application/json">{"error":"invalid_request","error_description":"Petición de token inválida"}</Payload>
            <StatusCode>400</StatusCode>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
