# Variables de entorno del backend (sección 9 de REQUERIMIENTOS_TECNICOS.md).
# Copiar a .env para desarrollo local. En Producción (Cloud Run), los secretos vienen de Secret Manager.

# --- General ---
APP_ENV=local                       # local | production
LOG_LEVEL=INFO
DOCS_ENABLED=true                   # Swagger en /docs (PENDIENTE-12)

# --- Base de datos ---
# URL completa, incluida la contraseña: es un secreto (en Producción viene de Secret Manager).
# Cloud Run (socket de Cloud SQL): postgresql+asyncpg://USER:PASS@/consents_db?host=/cloudsql/PROYECTO:REGION:INSTANCIA
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/consents_db

# --- Seguridad (endpoints de KIZUNA) ---
API_KEY_ENABLED=false               # false desactiva la validación (solo pruebas locales). En Producción: true
API_KEY_HEADER=X-API-Key
# Secreto. Obligatoria si API_KEY_ENABLED=true: si está vacía, la app no arranca.
API_KEY=
# Lista separada por comas. Producción: https://consentimiento.dominio.com (PENDIENTE-15)
CORS_ALLOWED_ORIGINS=http://localhost:4321

# --- Enlaces y landing ---
LINK_TTL_HOURS=168                  # vigencia del enlace en horas (1 semana)
# Base del enlace enviado por WhatsApp. Producción: https://consentimiento.dominio.com (PENDIENTE-15)
LANDING_BASE_URL=http://localhost:4321
PRIVACY_POLICY_URL=                 # PENDIENTE-14
PRIVACY_POLICY_VERSION=v1           # se guarda en la evidencia

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                  # secreto
TWILIO_WHATSAPP_FROM=               # whatsapp:+1XXXXXXXXXX (número nuevo y exclusivo)
TWILIO_CONTENT_SID=                 # HXxxxxxxxx (plantilla Call to Action "Revisar autorizaciones")
# Local: túnel de ngrok. Producción: https://<api>/api/v1/webhooks/twilio/status
TWILIO_STATUS_CALLBACK_URL=
TWILIO_SIGNATURE_VALIDATION_ENABLED=true   # false solo en local
PHONE_COUNTRY_PREFIX=51

# --- Notificación a KIZUNA (PENDIENTE-13) ---
KIZUNA_CALLBACK_ENABLED=false       # false: no sale ninguna petición; la notificación queda PENDIENTE
# API en el host (uv run uvicorn): localhost. Dentro de docker compose: http://kizuna-mock:8081/... (ya lo fija el compose)
KIZUNA_CALLBACK_URL=http://localhost:8081/kizuna/consent-result
KIZUNA_CALLBACK_AUTH_HEADER=
KIZUNA_CALLBACK_AUTH_VALUE=         # secreto
KIZUNA_CALLBACK_MAX_RETRIES=3       # reintentos después del primer intento
KIZUNA_CALLBACK_BACKOFF_SECONDS=5,30,120   # espera antes de cada reintento
KIZUNA_CALLBACK_TIMEOUT_SECONDS=10
